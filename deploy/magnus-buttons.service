[Unit]
Description=Magnus G1 showroom button trigger (RB -> welcome message)
# network-online + unlimited restarts: PC1's audio/motion services take ~1 min
# after power-on; the Restart loop IS the wait-for-robot-ready mechanism, and
# the default start-limit (5 in 10s) must never permanently fail the unit.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=unitree
WorkingDirectory=/home/unitree/magnus/magnus-g1
ExecStart=/home/unitree/magnus/venv/bin/python examples/button_trigger.py eth0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
